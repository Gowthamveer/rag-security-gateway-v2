# Copy to .env and replace every example secret before running.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
MODEL=llama3.1
MAX_UPLOAD_BYTES=10485760
# Optional for an OpenAI-compatible hosted provider:
# UPSTREAM_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=your-provider-api-key
